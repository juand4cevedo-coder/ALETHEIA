# Variables de los servicios de desarrollo.
# Cada clave se genera aparte y nunca se repite entre usuarios.

# Administrador de PostgreSQL: solo para crear los usuarios y para tareas manuales.
POSTGRES_USER=aletheia
POSTGRES_PASSWORD=
POSTGRES_DB=aletheia

# Usuarios de ALETHEIA (infra/postgres/bootstrap.sql). Se crean al primer arranque del
# contenedor; si cambian, hay que recrear el volumen con down -v.
ALETHEIA_OWNER_PASSWORD=
ALETHEIA_APP_PASSWORD=
ALETHEIA_SUPPORT_PASSWORD=
