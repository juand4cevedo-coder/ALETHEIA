[Unit]
Description=Copia diaria de PostgreSQL de ALETHEIA hacia S3
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/opt/aletheia/infra/prod/respaldar.sh
# Una copia atascada no debe dejar el servidor ocupado toda la noche.
TimeoutStartSec=1800
Nice=10
