# Caddy en producción (ADR-002): sirve la interfaz y envía /api a FastAPI, todo bajo el mismo
# origen. Obtiene y renueva solo el certificado de Let's Encrypt para los dos nombres.
# ALETHEIA_DOMINIO existe para probar la imagen en el equipo con localhost; en producción no se
# define y vale aletheia.sbs.
{
	# Sin API de administración: la configuración solo cambia publicando una imagen nueva.
	admin off
	# El grupo de seguridad abre el 443 por TCP; HTTP/3 usa UDP y no se anuncia.
	servers {
		protocols h1 h2
	}
	# Solo aplica a localhost: Caddy no intenta instalar su autoridad en el sistema.
	skip_install_trust
}

# Equivalente a Helmet (especificación, sección 9). Una prueba de humo las verifica.
(cabeceras) {
	header {
		# Solo HTTPS durante un año, también en www. Sin preload: es difícil de revertir.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Solo recursos del mismo origen: ni scripts en línea, ni terceros, ni marcos. La única excepción
		# es cdn.aletheia.sbs (CloudFront, ADR-051), que sirve los archivos estáticos del propio sitio.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.aletheia.sbs; style-src 'self' https://cdn.aletheia.sbs; img-src 'self' data: https://cdn.aletheia.sbs; font-src 'self' https://cdn.aletheia.sbs; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
	}
	# No anuncia el servidor. Va aparte porque Caddy aplica las eliminaciones al final, y así
	# las cabeceras de arriba se fijan de inmediato y también llegan en las respuestas de error.
	header -Server
}

{$ALETHEIA_DOMINIO:aletheia.sbs} {
	import cabeceras
	encode zstd gzip
	# Registro de accesos en JSON. Caddy oculta por defecto las cookies y Authorization.
	log

	# La API conserva su prefijo /api/v1. Caddy reemplaza los X-Forwarded-* que mande el
	# visitante, así que la API recibe la IP real y el esquema https.
	# Solo la subida de evidencias recibe cuerpos grandes: el tope es el del plan más alto (2 GiB);
	# la API aplica además el límite exacto del plan de cada cuenta mientras recibe el archivo.
	# Cualquier otra ruta de la API trabaja con JSON o formularios pequeños: 1 MiB basta y corta
	# antes de llegar a la aplicación un cuerpo enorme enviado a propósito.
	@subida {
		method POST
		path_regexp ^/api/v1/cases/[0-9a-f-]+/evidences$
	}
	handle @subida {
		request_body {
			max_size 2200MB
		}
		reverse_proxy api:8000 {
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}

	# Archivos de Vite: llevan una huella en el nombre, así que nunca cambian y se guardan un año.
	# Uno que no existe responde 404, no la página de inicio.
	handle /assets/* {
		root * /srv
		# Diferida: solo se aplica si el archivo existe; un 404 nunca se guarda en el navegador.
		header {
			Cache-Control "public, max-age=31536000, immutable"
			defer
		}
		# El build deja junto a cada archivo de texto su versión .br y .gz: se entregan tal cual
		# y Caddy no comprime en cada visita. encode queda para lo que no traiga la suya.
		file_server {
			precompressed br gzip
		}
	}

	# Imágenes, íconos y manifiesto: nombres fijos, así que no llevan huella. Una semana en el
	# navegador y un día más de gracia mientras se revalidan en segundo plano.
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		file_server
	}
	handle /brand/* {
		root * /srv
		header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		file_server
	}

	# El HTML se revalida en cada visita para que un despliegue se vea de inmediato. Cada página
	# pública tiene el suyo, prerenderizado al construir (dist/<ruta>/index.html); también se
	# sirven así los archivos de la raíz, como robots.txt o el mapa del sitio.
	@archivo {
		not path /api/* /assets/* /media/* /brand/*
		file {
			root /srv
			try_files {path}/index.html {path}
		}
	}
	handle @archivo {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path}/index.html {path}
		file_server {
			precompressed br gzip
		}
	}

	# Las pantallas de la aplicación sin HTML propio (ingreso, espacio de trabajo, enlaces que
	# llegan por correo) reciben la aplicación vacía y React las dibuja. La lista la genera el
	# build desde el enrutador: frontend/src/seo/html.ts, rutasDeLaAplicacion.
	import /etc/caddy/rutas-aplicacion.caddy
	handle @aplicacion {
		root * /srv
		header Cache-Control "no-cache"
		rewrite * /aplicacion.html
		file_server {
			precompressed br gzip
		}
	}

	# Cualquier otra dirección no existe: página 404 de verdad, con estado 404 y noindex, para
	# que los buscadores no la indexen como si fuera una página.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server {
			status 404
			precompressed br gzip
		}
	}

	# Errores (404 de un archivo, 502 si la API no responde): mensaje mínimo, sin detalles
	# internos y con las mismas cabeceras de seguridad.
	handle_errors {
		header -Server
		respond "{err.status_code} {err.status_text}"
	}
}

# www es solo una redirección permanente al dominio principal (ADR-018).
www.{$ALETHEIA_DOMINIO:aletheia.sbs} {
	import cabeceras
	redir https://{$ALETHEIA_DOMINIO:aletheia.sbs}{uri} permanent
}
