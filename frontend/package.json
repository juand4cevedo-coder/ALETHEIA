{
  "name": "aletheia-frontend",
  "private": true,
  "version": "0.32.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "openapi-ts && prettier --write --log-level warn src/api/generated",
    "build": "tsc -b && vite build && node scripts/check-bundle-budget.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "5.107.1",
    "qrcode-generator": "1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.0",
    "oxlint": "^1.93.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vitest": "5.1.0"
  }
}
