# Variables de la API. Copiar a backend/.env y completar; .env nunca entra al repositorio.

# development, test o production.
ALETHEIA_ENVIRONMENT=development

# DEBUG, INFO, WARNING o ERROR. DEBUG solo se acepta en development.
ALETHEIA_LOG_LEVEL=DEBUG

# Obligatoria. Usuario, clave y base definidos en infra/.env; el esquema postgresql+psycopg
# es obligatorio. Reemplazar CLAVE por la de infra/.env.
ALETHEIA_DATABASE_URL=postgresql+psycopg://aletheia:CLAVE@127.0.0.1:5432/aletheia

# Obligatoria para las migraciones; la API no la lee. Es el usuario dueño del esquema.
# Mientras la base no tenga roles propios, es el mismo usuario y la misma clave de infra/.env.
ALETHEIA_MIGRATION_DATABASE_URL=postgresql+psycopg://aletheia:CLAVE@127.0.0.1:5432/aletheia
