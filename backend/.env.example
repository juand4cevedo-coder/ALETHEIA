# Variables de la API. Copiar a backend/.env y completar; .env nunca entra al repositorio.

# development, test o production.
ALETHEIA_ENVIRONMENT=development

# DEBUG, INFO, WARNING o ERROR. DEBUG solo se acepta en development.
ALETHEIA_LOG_LEVEL=DEBUG

# Obligatoria. Usuario de la aplicación, sin permisos para cambiar el esquema; el esquema
# postgresql+psycopg es obligatorio. CLAVE es ALETHEIA_APP_PASSWORD de infra/.env.
ALETHEIA_DATABASE_URL=postgresql+psycopg://aletheia_app:CLAVE@127.0.0.1:5432/aletheia

# Obligatoria para las migraciones; la API no la lee. Usuario dueño del esquema.
# CLAVE es ALETHEIA_OWNER_PASSWORD de infra/.env.
ALETHEIA_MIGRATION_DATABASE_URL=postgresql+psycopg://aletheia_owner:CLAVE@127.0.0.1:5432/aletheia

# Opcionales. Servidor SMTP de desarrollo: Mailpit de infra/compose.dev.yaml. En production el
# correo sale por Amazon SES y estas dos no se usan.
# ALETHEIA_SMTP_HOST=127.0.0.1
# ALETHEIA_SMTP_PORT=1025

# Clave maestra de los enlaces de los correos y, desde HU-007, de las sesiones. Al menos 32
# caracteres aleatorios; se genera con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# En production no va aquí: se lee de Parameter Store.
ALETHEIA_TOKEN_SIGNING_KEY=

# Obligatoria fuera de production: llave RSA-3072 en PEM con la que se envuelven las llaves de
# los casos. Se genera con el comando del README (sección Backend). En production no se define:
# la llave maestra vive en AWS KMS.
ALETHEIA_LOCAL_KEY_PATH=../infra/dev-key.pem
