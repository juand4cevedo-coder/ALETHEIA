{
  "openapi": "3.1.0",
  "info": {
    "title": "ALETHEIA API",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "salud"
        ],
        "summary": "Estado del servicio y de la base de datos",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "La base de datos no responde.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/plans": {
      "get": {
        "tags": [
          "planes"
        ],
        "summary": "Catálogo público de planes",
        "operationId": "list_plans",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PublicPlan"
                  },
                  "type": "array",
                  "title": "Response List Plans"
                }
              }
            }
          },
          "503": {
            "description": "El catálogo no está disponible.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "cuenta"
        ],
        "summary": "Crear una cuenta con su organización y la prueba gratis",
        "operationId": "register_account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationAccepted"
                }
              }
            }
          },
          "409": {
            "description": "Los textos legales cambiaron; hay que recargar.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados registros desde esta IP.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "La solicitud tiene datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email/resend": {
      "post": {
        "tags": [
          "cuenta"
        ],
        "summary": "Reenviar el enlace para verificar el correo",
        "operationId": "resend_verification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationRequested"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas solicitudes.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "La solicitud tiene datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "tags": [
          "cuenta"
        ],
        "summary": "Verificar el correo con el enlace recibido",
        "operationId": "verify_email",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "description": "El enlace no es válido o ya venció.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "La solicitud tiene datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "cuenta"
        ],
        "summary": "Ingresar con correo y contraseña",
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Sesión abierta: llegan las cookies de acceso y de renovación."
          },
          "401": {
            "description": "El correo o la contraseña no coinciden.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "La cuenta está bloqueada.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos fallidos para la cuenta o desde la IP.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "La solicitud tiene datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "cuenta"
        ],
        "summary": "Renovar la sesión y rotar el token de renovación",
        "operationId": "refresh_session",
        "responses": {
          "204": {
            "description": "Sesión renovada: llegan cookies nuevas y la anterior deja de servir."
          },
          "401": {
            "description": "El token de renovación no sirve. Si ya se había usado, la sesión se cerró en todos los lugares donde estaba abierta.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "La solicitud tiene datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        },
        "security": [
          {
            "renovacion": []
          }
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "cuenta"
        ],
        "summary": "Cerrar la sesión de este dispositivo",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Sesión cerrada y cookies borradas."
          },
          "401": {
            "description": "No hay una sesión válida.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "La solicitud tiene datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "tags": [
          "cuenta"
        ],
        "summary": "Cerrar todas las sesiones, en todos los dispositivos",
        "operationId": "sign_out_everywhere",
        "responses": {
          "204": {
            "description": "Todas las sesiones cerradas, también esta; cookies borradas."
          },
          "401": {
            "description": "No hay una sesión válida.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "La solicitud tiene datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      }
    },
    "/api/v1/auth/password/forgot": {
      "post": {
        "tags": [
          "cuenta"
        ],
        "summary": "Pedir el enlace para restablecer la contraseña",
        "operationId": "forgot_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordResetRequested"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas solicitudes.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "La solicitud tiene datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password/reset": {
      "post": {
        "tags": [
          "cuenta"
        ],
        "summary": "Elegir una contraseña nueva con el enlace recibido",
        "operationId": "reset_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Contraseña cambiada; todas las sesiones quedaron cerradas."
          },
          "400": {
            "description": "El enlace no es válido o ya venció.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "La solicitud tiene datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "perfil"
        ],
        "summary": "Perfil, organización, rol y aceptación legal de quien tiene la sesión",
        "operationId": "read_me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "No hay una sesión válida.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      }
    },
    "/api/v1/me/legal-acceptance": {
      "post": {
        "tags": [
          "perfil"
        ],
        "summary": "Aceptar los textos legales vigentes",
        "operationId": "accept_legal_terms",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LegalAcceptanceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Aceptación registrada, o ya estaba registrada para estos textos."
          },
          "401": {
            "description": "No hay una sesión válida.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Los textos cambiaron mientras la persona los leía; hay que recargar.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "La solicitud tiene datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      }
    },
    "/api/v1/me/password": {
      "put": {
        "tags": [
          "perfil"
        ],
        "summary": "Cambiar la contraseña",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Contraseña cambiada; las demás sesiones quedaron cerradas."
          },
          "400": {
            "description": "La contraseña actual no coincide o la nueva es igual.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No hay una sesión válida.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos fallidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "La solicitud tiene datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Current Password",
            "description": "Contraseña actual."
          },
          "new_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "New Password",
            "description": "Contraseña nueva, de 12 a 128 caracteres."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "description": "Contraseña actual y nueva de quien tiene la sesión (API-013)."
      },
      "ForgotPasswordRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "description": "Correo de la cuenta."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "ForgotPasswordRequest",
        "description": "Correo al que se envía el enlace para restablecer la contraseña (API-011)."
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "const": "ok",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthStatus",
        "description": "Estado del servicio y de la base de datos cuando ambos responden."
      },
      "LegalAcceptanceRequest": {
        "properties": {
          "legal_version": {
            "type": "string",
            "maxLength": 20,
            "title": "Legal Version",
            "description": "Fecha de los textos que la persona leyó y acepta; debe ser la vigente."
          },
          "accepts_legal_terms": {
            "type": "boolean",
            "const": true,
            "title": "Accepts Legal Terms",
            "description": "Acepta los términos y autoriza el tratamiento de sus datos. Nunca se presume: la interfaz lo envía solo si la persona marcó la casilla."
          }
        },
        "type": "object",
        "required": [
          "legal_version",
          "accepts_legal_terms"
        ],
        "title": "LegalAcceptanceRequest",
        "description": "Aceptación expresa de los textos legales vigentes."
      },
      "LegalStatus": {
        "properties": {
          "accepted_version": {
            "type": "string",
            "title": "Accepted Version",
            "description": "Fecha (AAAA-MM-DD) de los textos que la persona aceptó por última vez."
          },
          "current_version": {
            "type": "string",
            "title": "Current Version",
            "description": "Fecha (AAAA-MM-DD) de los textos vigentes."
          },
          "acceptance_required": {
            "type": "boolean",
            "title": "Acceptance Required",
            "description": "Si debe aceptar los textos vigentes antes de seguir usando el servicio."
          }
        },
        "type": "object",
        "required": [
          "accepted_version",
          "current_version",
          "acceptance_required"
        ],
        "title": "LegalStatus",
        "description": "Qué textos legales aceptó la persona y si debe aceptar unos nuevos (RN-029)."
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "description": "Correo de la cuenta."
          },
          "password": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Password",
            "description": "Contraseña de la cuenta."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "description": "Correo y contraseña para ingresar (API-005)."
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Identificador de la persona."
          },
          "full_name": {
            "type": "string",
            "title": "Full Name",
            "description": "Nombre de la persona."
          },
          "email": {
            "type": "string",
            "title": "Email",
            "description": "Correo de la cuenta."
          },
          "email_verified": {
            "type": "boolean",
            "title": "Email Verified",
            "description": "Si ya verificó su correo (HU-006)."
          },
          "organization": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrganizationMembership"
              },
              {
                "type": "null"
              }
            ],
            "description": "Su organización, o null si ya no pertenece a ninguna."
          },
          "legal": {
            "$ref": "#/components/schemas/LegalStatus",
            "description": "Su aceptación de los textos legales."
          }
        },
        "type": "object",
        "required": [
          "id",
          "full_name",
          "email",
          "email_verified",
          "organization",
          "legal"
        ],
        "title": "Me",
        "description": "Perfil, organización y rol de quien tiene la sesión."
      },
      "OrganizationMembership": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Identificador de la organización."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Nombre de la oficina, la firma o la persona independiente."
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "lawyer",
              "assistant"
            ],
            "title": "Role",
            "description": "Rol de la persona en la organización."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "title": "OrganizationMembership",
        "description": "La organización de la persona y su rol en ella."
      },
      "PasswordResetRequested": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Qué sigue."
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "PasswordResetRequested",
        "description": "La misma respuesta exista o no una cuenta con ese correo (CA-HU-010-02)."
      },
      "Problem": {
        "additionalProperties": false,
        "description": "Error en formato Problem Details (RFC 9457).",
        "properties": {
          "type": {
            "description": "Identificador del tipo de problema.",
            "title": "Type",
            "type": "string"
          },
          "title": {
            "description": "Nombre del código HTTP.",
            "title": "Title",
            "type": "string"
          },
          "status": {
            "description": "Código HTTP de la respuesta.",
            "title": "Status",
            "type": "integer"
          },
          "instance": {
            "description": "Ruta de la petición que falló.",
            "title": "Instance",
            "type": "string"
          },
          "detail": {
            "description": "Explicación para quien usa la API.",
            "title": "Detail",
            "type": "string"
          },
          "request_id": {
            "description": "Identificador para encontrar la petición en registros.",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance"
        ],
        "title": "Problem",
        "type": "object"
      },
      "PublicPlan": {
        "properties": {
          "code": {
            "type": "string",
